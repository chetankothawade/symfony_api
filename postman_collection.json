{
  "info": {
    "_postman_id": "f5b0a2b2-7f8a-4c5e-9a1a-2a6f3f6d1c8a",
    "name": "Symfony Auth API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"Password@123\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/login",
          "host": ["{{base_url}}"],
          "path": ["api", "login"]
        }
      }
    },
    {
      "name": "Signup",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test@example.com\",\n  \"password\": \"Password@123\",\n  \"phone\": \"9999999999\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/signup",
          "host": ["{{base_url}}"],
          "path": ["api", "signup"]
        }
      }
    },
    {
      "name": "Forgot Password",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@example.com\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/forgot-password",
          "host": ["{{base_url}}"],
          "path": ["api", "forgot-password"]
        }
      }
    },
    {
      "name": "Reset Password",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@example.com\",\n  \"token\": \"<TOKEN_FROM_EMAIL>\",\n  \"password\": \"NewPass123\",\n  \"password_confirmation\": \"NewPass123\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/reset-password",
          "host": ["{{base_url}}"],
          "path": ["api", "reset-password"]
        }
      }
    },
    {
      "name": "Logout",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/api/logout",
          "host": ["{{base_url}}"],
          "path": ["api", "logout"]
        }
      }
    }
  ]
}
